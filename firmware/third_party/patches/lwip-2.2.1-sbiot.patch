diff --git a/contrib/ports/freertos/sys_arch.c b/contrib/ports/freertos/sys_arch.c
index 8568353..6978474 100644
--- a/contrib/ports/freertos/sys_arch.c
+++ b/contrib/ports/freertos/sys_arch.c
@@ -475,7 +475,13 @@ sys_thread_new(const char *name, lwip_thread_fn thread, void *arg, int stacksize
 
   /* lwIP's lwip_thread_fn matches FreeRTOS' TaskFunction_t, so we can pass the
      thread function without adaption here. */
+#ifdef LWIP_FREERTOS_STATIC_THREAD
+  /* SBIOT patch: lwIP's threads take a static stack from the port (spec §5.3). */
+  rtos_task = LWIP_FREERTOS_STATIC_THREAD(thread, name, rtos_stacksize, arg, prio);
+  ret = rtos_task != NULL ? pdTRUE : pdFALSE;
+#else
   ret = xTaskCreate(thread, name, (configSTACK_DEPTH_TYPE)rtos_stacksize, arg, prio, &rtos_task);
+#endif
   LWIP_ASSERT("task creation failed", ret == pdTRUE);
 
   lwip_thread.thread_handle = rtos_task;
diff --git a/src/core/ipv4/dhcp.c b/src/core/ipv4/dhcp.c
index 12e0068..d7f7baa 100644
--- a/src/core/ipv4/dhcp.c
+++ b/src/core/ipv4/dhcp.c
@@ -89,6 +89,10 @@
 #ifndef LWIP_HOOK_DHCP_APPEND_OPTIONS
 #define LWIP_HOOK_DHCP_APPEND_OPTIONS(netif, dhcp, state, msg, msg_type, options_len_ptr)
 #endif
+#ifndef LWIP_HOOK_DHCP_DNS /* SBIOT patch: without the hook, lwIP's own behaviour */
+#define LWIP_HOOK_DHCP_DNS(netif, n, servers) do { u8_t i_; for (i_ = 0; i_ < (n); i_++) { ip_addr_t a_; \
+    ip_addr_copy_from_ip4(a_, (servers)[i_]); dns_setserver(i_, &a_); } } while (0)
+#endif
 #ifndef LWIP_HOOK_DHCP_PARSE_OPTION
 #define LWIP_HOOK_DHCP_PARSE_OPTION(netif, dhcp, state, msg, msg_type, option, len, pbuf, offset) do { LWIP_UNUSED_ARG(msg); } while(0)
 #endif
@@ -737,10 +741,14 @@ dhcp_handle_ack(struct netif *netif, struct dhcp_msg *msg_in)
 
 #if LWIP_DHCP_PROVIDE_DNS_SERVERS
   /* DNS servers */
-  for (n = 0; (n < LWIP_DHCP_PROVIDE_DNS_SERVERS) && dhcp_option_given(dhcp, DHCP_OPTION_IDX_DNS_SERVER + n); n++) {
-    ip_addr_t dns_addr;
-    ip_addr_set_ip4_u32_val(dns_addr, lwip_htonl(dhcp_get_option_value(dhcp, DHCP_OPTION_IDX_DNS_SERVER + n)));
-    dns_setserver(n, &dns_addr);
+  /* SBIOT patch: the lease's whole DNS list (0, 1 or 2 servers) goes to the port once per accepted ACK; the port
+     keeps each link's servers and sets lwIP's own (spec §7.1, §7.2, Plan 10 ruling 5). */
+  {
+    ip4_addr_t dns_addrs[LWIP_DHCP_PROVIDE_DNS_SERVERS];
+    for (n = 0; (n < LWIP_DHCP_PROVIDE_DNS_SERVERS) && dhcp_option_given(dhcp, DHCP_OPTION_IDX_DNS_SERVER + n); n++) {
+      ip4_addr_set_u32(&dns_addrs[n], lwip_htonl(dhcp_get_option_value(dhcp, DHCP_OPTION_IDX_DNS_SERVER + n)));
+    }
+    LWIP_HOOK_DHCP_DNS(netif, n, dns_addrs);
   }
 #endif /* LWIP_DHCP_PROVIDE_DNS_SERVERS */
 }
